{
  "manifest_version": 2,
  "mod": {
    "id": "video-preview",
    "name": "Native Video Track",
    "version": "0.5.0-dev.3",
    "author": "Amo Nova",
    "description": "Native video editing, synchronized audio and docked preview. Windows x64 / Bitwig 6.1.7 only. Downloads verified mpv on first use.",
    "documentation": "readme"
  },
  "built_against": {"bitwig_version": "6.1.7", "platform": "windows", "architecture": "x64"},
  "requires": [
    {"id": "action-menu-composition-framework", "min_version": "0.8.0-dev.1"},
    {"id": "panel-management-framework", "min_version": "0.2.0-dev.2"},
    {"id": "preferences-composition-framework", "min_version": "1.0.0"}
  ],
  "resources": {
    "readme": {"kind": "file", "path": "README.md", "media_type": "text/markdown"},
    "ui": {"kind": "file", "path": "helper.jar"},
    "video_icon": {"kind": "file", "path": "video.svg", "media_type": "image/svg+xml"},
    "player": {"kind": "directory", "path": "player"},
    "logs": {"kind": "directory", "path": "logs", "persistence": "preserve"}
  },
  "registrations": [
    {"id": "actions", "consumer": "action-menu-composition-framework", "descriptor": "actions.properties", "jar": "helper.jar"}
  ]
}
